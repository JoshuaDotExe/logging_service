FROM golang:alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN go build -o /tokenhandler ./cmd/tokenhandler

FROM alpine:latest
RUN apk add --no-cache ca-certificates \
    && adduser -D -H appuser
COPY --from=build /tokenhandler /tokenhandler
USER appuser
CMD ["/tokenhandler"]
