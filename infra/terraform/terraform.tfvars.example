# Local-only example. In GitHub Actions these come from secrets and variables
# as TF_VAR_* environment variables. Copy to terraform.tfvars (gitignored).
tenancy_ocid     = "ocid1.tenancy.oc1..example"
user_ocid        = "ocid1.user.oc1..example"
fingerprint      = "aa:bb:cc:dd:ee:ff:00:11:22:33:44:55:66:77:88:99"
private_key      = <<-EOT
-----BEGIN PRIVATE KEY-----
...
-----END PRIVATE KEY-----
EOT
region           = "uk-london-1"
compartment_ocid = "ocid1.compartment.oc1..example"

deploy_ssh_public_key = "ssh-ed25519 AAAA... github-actions-deploy"
# admin_ssh_public_key = "ssh-ed25519 AAAA... you@laptop"
# admin_ssh_cidrs      = ["203.0.113.10/32"]
# instance_ocpus       = 2
# instance_memory_gbs  = 12
