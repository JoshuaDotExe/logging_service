FROM golang:alpine AS build
WORKDIR /src

COPY go.mod ./
RUN go mod download

COPY . .
RUN go build -o /logkeymanager ./cmd/logkeymanager

FROM alpine:latest
RUN apk add --no-cache ca-certificates \
    && adduser -D -H appuser

COPY --from=build /logkeymanager /logkeymanager
USER appuser

EXPOSE 8082
CMD ["/logkeymanager"]