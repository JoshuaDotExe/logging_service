FROM golang:alpine AS build
WORKDIR /src

COPY go.mod ./
RUN go mod download

COPY . .
RUN go build -o /logservice ./cmd/logservice

FROM alpine:latest
RUN apk add --no-cache ca-certificates \
    && adduser -D -H appuser

COPY --from=build /logservice /logservice
USER appuser

EXPOSE 8080
CMD ["/logservice"]