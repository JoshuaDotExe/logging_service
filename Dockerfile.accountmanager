FROM golang:alpine AS build
WORKDIR /src

COPY go.mod ./
RUN go mod download

COPY . .
RUN go build -o /accountmanager ./cmd/accountmanager

FROM alpine:latest
RUN apk add --no-cache ca-certificates \
    && adduser -D -H appuser

COPY --from=build /accountmanager /accountmanager
USER appuser

EXPOSE 8081
CMD ["/accountmanager"]